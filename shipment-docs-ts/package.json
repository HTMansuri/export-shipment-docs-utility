{
  "name": "shipment-document-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Generate box labels from Excel packing lists using a web interface or command line",
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run typecheck && npm run build --workspace web",
    "start": "tsx src/server.ts",
    "labels": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "sample": "tsx scripts/create-sample.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {"node": ">=20"}
}
